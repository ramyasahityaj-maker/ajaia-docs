{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff --quiet HEAD~ HEAD -- . ':!README.md'",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
